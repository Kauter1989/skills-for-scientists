# .credentials.yaml — managed credential store of dsh (TEMPLATE, no values)
#
# Live file: $DSH_HOME/.credentials.yaml
#   Windows: %USERPROFILE%\.dsh\.credentials.yaml
#   Linux/macOS: ~/.dsh/.credentials.yaml
#
# DO NOT:
#   - commit this file or copy it between machines: grants (browser session,
#     DeepSeek account) are bound to one installation;
#   - paste `refs` values into chats, tickets or documents.
#
# For a move to another PC this store is usually not needed at all: an
# environment variable is enough and dsh resolves the key from it. Credential
# source order: managed `$DSH_HOME/.credentials.yaml` -> inherited environment
# -> project `.env` -> user `.env`.
#
# Option A (recommended): key in the environment only, leave this file alone.
#   PowerShell: [Environment]::SetEnvironmentVariable('QWEN_TOKEN_PLAN_API_KEY','<key>','User')
#   bash:       echo 'export QWEN_TOKEN_PLAN_API_KEY=<key>' >> ~/.bashrc
#
# Option B: key in the managed store. The reference name equals `apiKeyEnv`
# from cordis.patch.yml; the value must stay a single plain scalar.
#
# There is deliberately no `grants` section: the client-connection/browser-session
# row is created by dsh itself on first launch.

version: 1
records: {}
refs:
  QWEN_TOKEN_PLAN_API_KEY: "<key>"